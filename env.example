# --- Notre base de données métier (postgres_app) ---
# En local (hors Docker) : DB_HOST=localhost
# Sous Docker Compose : DB_HOST=postgres_app (nom du service, pas "localhost")
DB_HOST=postgres_app
DB_PORT=5432
DB_NAME=weather_etl
DB_USER=postgres
DB_PASSWORD=remplace_par_ton_vrai_mot_de_passe

# --- Requis par Airflow lui-même ---
# Sous Windows/Mac, cette valeur n'a pas d'impact réel (elle sert surtout
# à gérer les permissions de fichiers sous Linux) mais doit être définie
# pour éviter un avertissement au démarrage.
AIRFLOW_UID=50000

# Clé de chiffrement utilisée par Airflow pour ses connexions internes.
# À générer toi-même (voir instructions), jamais une valeur par défaut.
FERNET_KEY=remplace_par_une_vraie_cle_generee

# Identifiants du compte administrateur créé automatiquement au premier
# démarrage, pour te connecter à l'interface web d'Airflow (localhost:8080).
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=remplace_par_un_mot_de_passe
